# Copy to .env (cp .env.example .env). Docker Compose sets its own values inside containers.

# Databases on the Docker Compose Postgres (published on DB_PORT)
DATABASE_URL=postgresql://bike:bike@localhost:5433/bike_repair
# Integration tests empty this database on every run. Its name must contain "test".
TEST_DATABASE_URL=postgresql://bike:bike@localhost:5433/bike_repair_test
# Playwright runs its own API (port 3100) and web (port 5199) against this database.
E2E_DATABASE_URL=postgresql://bike:bike@localhost:5433/bike_repair_e2e

# IANA zone for the shop; decides when a promised-by day has ended.
SHOP_TIME_ZONE=America/Vancouver

# Host ports published by Docker Compose. If you change DB_PORT, update the database URLs above.
DB_PORT=5433
APP_PORT=8080
